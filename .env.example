# SHIFTWISE_MODEL=gemini-3.5-flash-lite
# Optional: browser origins allowed to call the API, comma separated (default: localhost / 127.0.0.1, any port)
# SHIFTWISE_CORS_ORIGINS=https://shiftwise.example
